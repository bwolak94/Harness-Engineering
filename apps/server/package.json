{
  "name": "@harness/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "harness:resume": "tsx src/cli/resume.ts",
    "harness:replay": "tsx src/cli/replay.ts"
  },
  "dependencies": {
    "@harness/contracts": "workspace:*",
    "@harness/core": "workspace:*",
    "@harness/adapters-memory": "workspace:*",
    "@harness/adapters-postgres": "workspace:*",
    "@harness/adapters-llm": "workspace:*",
    "@harness/adapters-sandbox": "workspace:*",
    "@harness/observability": "workspace:*",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
